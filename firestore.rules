rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'admin@rugscreation.com';
    }

    function isLegacyEmployee() {
      return signedIn() && request.auth.token.email == 'employee@rugscreation.com';
    }

    function isApprovedUser() {
      return isAdmin() || isLegacyEmployee() || (
        signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
      );
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'employee'
        && request.resource.data.status == 'pending'
        && request.resource.data.username is string
        && request.resource.data.fullName is string;

      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);

      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullName', 'phone', 'updatedAt', 'lastLoginAt', 'loginCount', 'loginHistory'])
      );

      allow delete: if isAdmin();
    }

    match /rugs_creation/master_data_v5 {
      allow read, write: if isApprovedUser();
    }

    match /costing_history/{document} {
      allow read, create: if isApprovedUser();
      allow update, delete: if isAdmin();
    }
  }
}

